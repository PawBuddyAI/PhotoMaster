{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口权限：请求任意 OpenAI 兼容服务、弹出另存为对话框、写入对话框选定的文件",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*:*" },
        { "url": "https://*:*" }
      ]
    },
    "dialog:allow-save",
    "fs:allow-write-file"
  ]
}
