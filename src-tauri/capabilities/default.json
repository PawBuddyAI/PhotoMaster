{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口权限：请求任意 OpenAI 兼容服务、弹出另存为对话框、写入对话框选定的文件、关闭前补存后销毁窗口并在保存失败时弹出确认、在系统浏览器打开 PawBuddy 网站、读取启动时的 ai-photo-master:// 深链",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*:*" },
        { "url": "https://*:*" }
      ]
    },
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:allow-write-file",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "deep-link:default"
  ]
}
